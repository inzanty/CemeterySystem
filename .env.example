# Django reads environment variables; this file is a reference, not automatically loaded.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set a unique secret before deployment; development has a local fallback.
# DJANGO_SECRET_KEY=replace-with-a-random-secret
# SQLITE_PATH=/absolute/path/to/db.sqlite3
# Optional PostgreSQL (install requirements-postgres.txt):
# DB_ENGINE=postgresql
# DB_NAME=cemetery
# DB_USER=cemetery
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# Optional persistent local storage outside the source checkout:
# MEDIA_ROOT=/absolute/path/to/persistent/media
# Docker deployment configuration: deploy/.env.example
